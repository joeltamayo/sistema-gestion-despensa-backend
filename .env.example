# development | production
NODE_ENV=development

# Puerto del servidor
PUERTO=3000

# Origen EXACTO del cliente (sin "/" al final). Debe coincidir con la dirección que muestra el navegador: http://localhost:5500 (no http://127.0.0.1:5500)
ORIGEN_CLIENTE=http://localhost:5500

# Clave para firmar la cookie de sesión (mínimo 32 caracteres, aleatoria).
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Ruta de la base de datos SQLite (relativa a la carpeta servidor/)
RUTA_BD=database/despensa.db

# Duración de la sesión, en horas
SESION_HORAS=2

# Control de intentos de inicio de sesión
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
BLOQUEO_INTENTOS=5
BLOQUEO_MIN=15
